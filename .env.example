# ── Telegram ───────────────────────────────
TELEGRAM_BOT_TOKEN=isi_token_dari_BotFather

# ── Mode ───────────────────────────────────
# true  = development: tetap bisa bayar walau printer belum terhubung (cetak disimulasikan)
# false = produksi: printer tidak terhubung -> "Mesin sedang tidak aktif"
DEV_MODE=true

# ── Printer (CUPS) ─────────────────────────
# Kosongkan untuk pakai printer default CUPS. Cek nama dengan: lpstat -p  atau /printer di bot
PRINTER_NAME=

# ── Midtrans ───────────────────────────────
# Sandbox: Server Key diawali "SB-Mid-server-"
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false
QRIS_ACQUIRER=gopay
PAYMENT_EXPIRY_MINUTES=10
PAYMENT_POLL_INTERVAL=5

# ── Operasional ────────────────────────────
HARGA_BW=500
HARGA_COLOR=1500
CS_CONTACT=@cs_vendingprint
# ── Tampilan gambar QRIS ───────────────────
# Logo: simpan logo-vp.png dan logo-itera.png di folder yang sama dengan bot.py
BRAND_COLOR=#1F4E9C
ACCENT_COLOR=#F7941D
# Cadangan nama merchant/NMID (biasanya otomatis terbaca dari kode QR Midtrans)
MERCHANT_NAME=VendingPrint
MERCHANT_NMID=
# ID Telegram admin (pisahkan koma) yang boleh memakai /printer. Kosong = semua orang.
ADMIN_IDS=

